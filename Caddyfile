# Caddy config for the living app.
#
# Every deployment is behind Cloudflare — init requires a domain plus a CF zone,
# there is no direct-to-origin route:
#   - Rate limiting lives at the CF edge, keyed on the REAL client IP (written
#     once at init by the create-longlive CLI via the Cloudflare Rulesets API;
#     it is zone state, so no file in this repo configures it). The
#     previous `key {remote_host}` would otherwise see CF's edge IP shared
#     across thousands of users, throttling legit users and multiplying
#     attacker throughput across PoPs.
#   - Authenticated Origin Pulls: CF presents a client cert signed by CF's
#     Origin Pull CA on every origin connection. Caddy requires+verifies it
#     (the `tls { client_auth { ... } }` block below is always rendered), so a
#     direct hit on the VPS IP — bypassing CF and its edge rate limit — fails
#     the TLS handshake before any HTTP happens. No CF-IP allowlist to maintain.
#     Enforcement is unconditional in both directions: init turns origin pulls on
#     at the zone and reads the setting back, because an origin demanding a
#     client cert in front of a zone that does not present one serves only 520.
#
# Static snapshot + stale-while-revalidate:
#   For `/` (the homepage), Caddy serves a prerendered HTML snapshot from
#   /var/lib/caddy/snapshots/index.html if it exists. This file is written by
#   the app's /api/snapshot endpoint, which the app calls after every
#   non-cached request. While the snapshot is being regenerated in the
#   background, Caddy serves the stale copy to new visitors — a HN spike then
#   costs almost nothing, because most requests are served directly from the
#   filesystem without touching Node.js at all. The Cache-Control header tells
#   Cloudflare (+ any downstream cache) the same: serve stale for up to 7 days
#   while revalidating.
longlivethis.site {
  tls {
    client_auth {
      mode require_and_verify
      trusted_ca_cert_file /etc/caddy/cloudflare-origin.pem
    }
  }

  encode gzip

  # Snapshot cache for the root path: serve prerendered HTML when available,
  # fall back to the live app.
  handle_path / {
    @cached file /var/lib/caddy/snapshots/index.html
    handle @cached {
      root * /var/lib/caddy/snapshots
      file_server
      header Cache-Control "public, s-maxage=60, stale-while-revalidate=604800"
    }
    handle {
      reverse_proxy localhost:3000 {
        header_up X-Snapshot-Serve "live"
      }
    }
  }

  # All other paths proxy straight through — only the homepage is cached.
  handle {
    reverse_proxy localhost:3000
  }
}
